{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "api": {
      "entry": ["src/**/*.test.ts", "test/integration/**/*.test.ts"],
      "project": ["src/**/*.ts", "prisma/**/*.ts", "test/**/*.ts"]
    },
    "web": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
